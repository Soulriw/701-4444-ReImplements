<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/x-icon" href="/src/Model/image/navImg/logo.png" />

    <title>Product Management</title>

    <!--- Fonts --->
    <link href="https://fonts.googleapis.com/css?family=Irish Grover" rel="stylesheet" />

    <!--- Bootstrap --->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-KK94CHFLLe+nY2dmCWGMq91rCGa5gtU4mk92HdvYe+M/SXH301p5ILy+dN9+nJOZ" crossorigin="anonymous" />

    <!--- CSS --->
    <link rel="stylesheet" href="/src/View/css/homePage.css" />
    <link rel="stylesheet" href="/src/View/css/navBar.css" />
    <link rel="stylesheet" href="/src/View/css/productManagement.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

    <!--- JavaScript --->
    <script src="/src/Controller/homeScript.js"></script>
    <script src="/src/Controller/navBarScript.js"></script>
    <script src="/src/Controller/productManagementScript.js" defer></script>
</head>

<body>
    <!--- NavBar --->
    <nav><%- include('navBarBO');%></nav>
    <!-- NavBar End -->

    <!-- line -->
    <div class="divider"></div>

    <!-- star -->
    <div class="stars"></div>

    <!-- Product Management Section -->
    <!-- Page Header -->
    <div class="row text-center">
        <div class="col-12 text-center rec">
            <br>
            <br>
            <h1>Product Management</h1>
        </div>
    </div>

    <div class="divider"></div>

    <!-- Category Filter -->
    <div class="category-container">

        <!-- Category Cards  -->
        <div class="categories-wrapper">
            <% if (categories && categories.length> 0) { %>
                <% const visibleCategories=categories.slice(0, 3); %>
                    <% visibleCategories.forEach((category, index)=> { %>
                        <div class="category-card <%= index === 0 ? 'active' : '' %>"
                            data-category="<%= category.categoryID %>">
                            <span>
                                <%= category.categoryName %>
                            </span>
                        </div>
                        <% }); %>
                            <% } else { %>
                                <div class="category-card active" data-category="1">
                                    <span>No Categories Found</span>
                                </div>
                                <% } %>
        </div>

        <!-- Category Pagination -->
        <div class="category-pagination">

            <!-- Previous Page Button -->
            <button class="pagination-btn prev-btn" id="categoryPrevBtn" disabled>Prev</button>

            <!-- Page Numbers -->
            <div class="page-numbers" id="categoryPageNumbers">
                <div class="page-number active">1</div>
                <% if (categories && Math.ceil(categories.length / 3)> 1) { %>
                    <div class="page-number">2</div>
                    <% } %>
            </div>

            <!-- Next Page Button -->
            <button class="pagination-btn next-btn" id="categoryNextBtn" <%=categories && Math.ceil(categories.length /
                3) <=1 ? 'disabled' : '' %>>Next</button>
        </div>
    </div>

    <div class="divider"></div>

    <!-- Products Table Section -->
    <div class="products-table-container">
        <div class="table-responsive">
            <table class="products-table">

                <!-- Table Header -->
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Pro-Price</th>
                        <th>Price</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <!-- Table Body -->
                <tbody id="productsTableBody">
                    <!-- Products will be loaded here via JavaScript -->
                    <tr>
                        <td colspan="5" class="text-center">Loading products...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Products Pagination -->
    <div class="product-pagination">

        <!-- Previous Page Button -->
        <button class="pagination-btn prev-btn" id="productPrevBtn" disabled>Prev</button>

        <!-- Page Numbers -->
        <div class="page-numbers" id="productPageNumbers">
            <div class="page-number active">1</div>
        </div>

        <!-- Next Page Button -->
        <button class="pagination-btn next-btn" id="productNextBtn">Next</button>
    </div>

    <!-- Add Product Button -->
    <div class="add-product-container">
        <button class="add-product-btn" id="addProductBtn">+ Add New Product</button>
    </div>

    <!-- Modal: Add/Edit Product -->
    <div class="product-modal" id="productModal">
        <div class="product-modal-content">

            <!-- Modal Close Button -->
            <span class="close-modal">&times;</span>

            <!-- Modal Title -->
            <h2 id="modalTitle">Add New Product</h2>

            <!-- Product Form -->
            <form id="productForm">
                <!-- Hidden Field for Book ID (used for editing) -->
                <input type="hidden" id="bookID" name="bookID">

                <!-- Book Name Field -->
                <div class="form-group">
                    <label for="bookName">Book Name</label>
                    <input type="text" id="bookName" name="bookName" required minlength="3" maxlength="255">
                </div>

                <!-- Category Selection -->
                <div class="form-group">
                    <label for="categoryID">Category</label>
                    <select id="categoryID" name="categoryID" required>
                        <% if (categories && categories.length> 0) { %>
                            <% categories.forEach(category=> { %>
                                <option value="<%= category.categoryID %>">
                                    <%= category.categoryName %>
                                </option>
                                <% }); %>
                                    <% } else { %>
                                        <option value="">No Categories Available</option>
                                        <% } %>
                    </select>
                </div>

                <!-- Book Description Field -->
                <div class="form-group">
                    <label for="bookDescription">Description</label>
                    <textarea id="bookDescription" name="bookDescription" rows="4" required minlength="10"
                        maxlength="1000"></textarea>
                </div>

                <!-- Regular Price Field -->
                <div class="form-group">
                    <label for="price">Price</label>
                    <input type="number" id="price" name="price" step="1" min="0" required>
                </div>

                <!-- Promotional Toggle -->
                <div class="form-group">
                    <div class="promotion-toggle-container">
                        <label class="promotion-toggle">
                            <input type="checkbox" id="isPromotionBook" name="isPromotionBook">
                            <span class="promotion-toggle-slider"></span>
                        </label>
                        <span class="promotion-toggle-text">Add to Promotion Book</span>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="proPrice">Promotion Price</label>
                    <input type="number" id="proPrice" name="proPrice" step="1" min="0" style="opacity: 0.5;" disabled>
                </div>

                <!-- Form Action Buttons -->
                <div class="form-buttons">
                    <button type="button" class="cancel-btn">Cancel</button>
                    <button type="submit" class="save-btn" id="saveButton">Save</button>
                </div>

                <!-- Loading Overlay -->
                <div class="form-overlay" id="formOverlay"></div>
            </form>
        </div>
    </div>

    <!-- Modal: Delete Confirmation -->
    <div class="delete-modal" id="deleteModal">
        <div class="delete-modal-content">

            <!-- Modal Title -->
            <h2>Confirm Deletion</h2>

            <!-- Confirmation Message -->
            <p>Are you sure you want to delete this product?</p>

            <!-- Action Buttons -->
            <div class="delete-modal-buttons">
                <button id="cancelDeleteBtn">Cancel</button>
                <button id="confirmDeleteBtn">Delete</button>
            </div>

            <!-- Loading Overlay -->
            <div class="delete-overlay" id="deleteOverlay"></div>
        </div>
    </div>

    <!-- Modal: View Description -->
    <div class="description-modal" id="descriptionModal">
        <div class="description-modal-content">

            <!-- Modal Close Button -->
            <span class="close-modal" id="closeDescriptionModal">&times;</span>

            <!-- Modal Title -->
            <h2>Book Description</h2>

            <!-- Description Content -->
            <div class="description-content" id="descriptionContent">
                <!-- Description will be loaded here -->
            </div>

            <!-- Action Button -->
            <div class="description-modal-buttons">
                <button id="closeDescriptionBtn">Close</button>
            </div>
        </div>
    </div>

    <div class="divider"></div>
</body>

</html>