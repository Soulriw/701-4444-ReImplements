<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/x-icon" href="/src/Model/image/navImg/logo.png" />

  <title>Search Page</title>

  <!--- Fonts --->
  <link href="https://fonts.googleapis.com/css?family=Irish Grover" rel="stylesheet" />

  <!--- Bootstrap --->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet" />

  <!--- CSS --->
  <link rel="stylesheet" href="/src/View/css/homePage.css" />
  <link rel="stylesheet" href="/src/View/css/navBar.css" />
  <link rel="stylesheet" href="/src/View/css/searchPage.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

  <!--- JavaScript --->

  <script src="/src/Controller/homeScript.js"></script>
  <script src="/src/Controller/searchScript.js"></script>
  <script src="/src/Controller/navBarScript.js"></script>

</head>

<body class="home-page">
  <!--- NavBar --->
  <nav>
    <%- include('navBar');%>
  </nav>
  <!-- NavBar End -->

  <div class="stars"></div>

  <!--line-->
  <div class="divider"></div>

  <!-- Page Header -->
  <div id="searchResultsSection" style="display: none;">
    <div class="row text-center">
      <div class="col-12 text-center rec">
        <br>
        <br>
        <h1>Search Results</h1>
      </div>
    </div>

    <!-- Search Results Grid -->
    <div class="search-container">
      <a href="/productDetail" style="text-decoration: none;">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 justify-content-center g-4"
          id="searchResults">

          <!-- Search results will be inserted here -->
        </div>
      </a>
    </div>

    <!-- Pagination Controls -->
    <div class="pagination-container" style="display: none;">

      <!-- Previous Page Button -->
      <button class="pagination-btn prev-btn">Prev</button>

      <!-- Page Numbers Container -->
      <div class="page-numbers">
        <!-- Page numbers will be inserted here -->
      </div>

      <!-- Next Page Button -->
      <button class="pagination-btn next-btn">Next</button>
    </div>
    <div class="divider"></div>
  </div>
</body>

</html>