<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register Page</title>

    <!--- Fonts --->
    <link rel="stylesheet" href="/src/View/css/logIn.css" />
    <link rel="stylesheet" href="/src/View/css/navBar.css">
    <link
      href="https://fonts.googleapis.com/css?family=Irish Grover"
      rel="stylesheet"
    />
</head>
<body>

    <div class="container">
        <nav class="navbar navbar-expand-lg bg-black" style="height: 50px;"></nav>

        <!--- Page Header --->
        <h1>CREATE AN ACCOUNT</h1>
        <div class="divider"></div>
       
        <!--- Registration Box --->
        <div class="login-box">

            <!-- Logo Section -->
            <div class="logo-section">
                <div class="logo">
                    <img src="/src/Model/image/login/logofull.png" alt="Quad Grimoire Logo" class="logo-img">
                    
                </div>
            </div>
            
            <!-- Form Section -->
            <div class="form-section">

                <!-- Error Message Display -->
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="error-message">
                        <%= error %>
                    </div>
                <% } %>

                <!-- Registration Form -->
                <form action="/register" method="POST">
                    
                    <!-- Username Field -->
                    <div class="input-group-username">
                        <label for="username"><img  src="/src/Model/image/login/username.png" alt="username" class="username-img"></label>
                        <input type="text" id="username" name="username" placeholder="Username" value="<%= typeof username !== 'undefined' ? username : '' %>" required>
                    </div>
                    
                    <!-- Password Field -->
                    <div class="input-group-password">
                        <label for="password"><img src="/src/Model/image/login/password.png" alt="password" class="password-img"></label>
                        <input type="password" id="password" name="password" placeholder="Password" required>
                    </div>
                        <br>
                    
                        <!-- Confirm Password Field -->
                    <div class="input-group-password">
                        <label for="confirmPassword"><img src="/src/Model/image/login/password.png" alt="confirm password" class="password-img"></label>
                        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm Password" required>
                    </div>
                    
                    <!-- Register Button -->
                    <button type="submit" class="login-btn">REGISTER</button>
                    
                    <!-- Login Link -->
                    <div class="register">
                        <p>already have an account?</p>
                        <a href="/login">Log in</a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</body>
</html>