<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/x-icon" href="/src/Model/image/navImg/logo.png" />

    <title>Purchase History</title>

    <!--- Fonts --->
    <link href="https://fonts.googleapis.com/css?family=Irish Grover" rel="stylesheet" />

    <!--- Bootstrap --->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-KK94CHFLLe+nY2dmCWGMq91rCGa5gtU4mk92HdvYe+M/SXH301p5ILy+dN9+nJOZ" crossorigin="anonymous" />

    <!--- CSS --->
    <link rel="stylesheet" href="/src/View/css/homePage.css" />
    <link rel="stylesheet" href="/src/View/css/navBar.css" />
    <link rel="stylesheet" href="/src/View/css/history.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

    <!--- JavaScript --->
    <script src="/src/Controller/homeScript.js"></script>
    <script src="/src/Controller/navBarScript.js"></script>
    <script src="/src/Controller/historyScript.js" defer></script>
</head>

<body>
    <!--- NavBar --->
    <nav><%- include('navBarBO');%></nav>
    <!-- NavBar End -->

    <!-- line -->
    <div class="divider"></div>

    <!-- star -->
    <div class="stars"></div>

    <!-- Page Header -->
    <div class="row text-center">
        <div class="col-12 text-center rec">
            <br>
            <br>
            <h1>Purchase History</h1>
        </div>
    </div>

    <div class="divider"></div>

    <!-- Summary Section -->
    <div class="summary-container">

        <!-- Books Count Card -->
        <div class="summary-card">
            <div class="summary-icon">
                <i class="fas fa-book"></i>
            </div>
            <div class="summary-info">
                <h3>Total Books</h3>
                <p id="totalBooks">0</p>
            </div>
        </div>

        <!-- Revenue Card -->
        <div class="summary-card">
            <div class="summary-icon">
                <i class="fas fa-coins"></i>
            </div>
            <div class="summary-info">
                <h3>Total Revenue</h3>
                <p id="totalRevenue">0 G</p>
            </div>
        </div>

        <!-- Orders Count Card -->
        <div class="summary-card">
            <div class="summary-icon">
                <i class="fas fa-shopping-cart"></i>
            </div>
            <div class="summary-info">
                <h3>Total Orders</h3>
                <p id="totalOrders">0</p>
            </div>
        </div>
    </div>

    <div class="divider"></div>

    <!-- Purchase History Table -->
    <div class="history-table-container">
        <div class="table-responsive">
            <table class="history-table">

                <!-- Table Header -->
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Book</th>
                        <th>Category</th>
                        <th>Quantity</th>
                        <th>Price</th>
                        <th>Total</th>
                        <th>Enchantment</th>
                    </tr>
                </thead>

                <!-- Table Body -->
                <tbody id="historyTableBody">
                    <!-- History data will be loaded here via JavaScript -->
                    <tr>
                        <td colspan="7" class="text-center">Loading purchase history...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination Controls -->
    <div class="history-pagination">

        <!-- Previous Page Button -->
        <button class="pagination-btn prev-btn" id="historyPrevBtn" disabled>Prev</button>

        <!-- Page Numbers Container -->
        <div class="page-numbers" id="historyPageNumbers">
            <div class="page-number active">1</div>
        </div>

        <!-- Next Page Button -->
        <button class="pagination-btn next-btn" id="historyNextBtn">Next</button>
    </div>

    <div class="divider"></div>
</body>

</html>