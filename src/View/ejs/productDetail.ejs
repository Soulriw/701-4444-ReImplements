<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/x-icon" href="/src/Model/image/navImg/logo.png" />

  <title>
    <%= book.bookName %> | Product Detail
  </title>

  <!--- Fonts --->
  <link href="https://fonts.googleapis.com/css?family=Irish Grover" rel="stylesheet" />

  <!--- Bootstrap --->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-KK94CHFLLe+nY2dmCWGMq91rCGa5gtU4mk92HdvYe+M/SXH301p5ILy+dN9+nJOZ" crossorigin="anonymous" />

  <!--- CSS --->
  <link rel="stylesheet" href="/src/View/css/homePage.css" />
  <link rel="stylesheet" href="/src/View/css/navBar.css" />
  <link rel="stylesheet" href="/src/View/css/productDetail.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

  <!--- JavaScript --->
  <script src="/src/Controller/homeScript.js"></script>
  <script src="/src/Controller/navBarScript.js"></script>
  <script src="/src/Controller/productDetail.js"></script>
</head>

<body>
  <!--- NavBar --->
  <nav>
    <%- include('navBar');%>
  </nav>
  <!-- NavBar End -->

  <!-- star -->
  <div class="stars"></div>

  <!-- Product Detail Section -->
  <div class="product-container">
    <div class="product-detail">

      <!-- Product Image -->
      <div class="product-image">
        <img src="/src/Model/image/books/<%= book.bookID %>.jpg" alt="<%= book.bookName %>"
          onerror="this.src='/src/Model/image/books/default.jpg'" />
      </div>

      <!-- Product Information -->
      <div class="product-info">

        <!-- Product Title -->
        <h1 class="product-title">
          <%= book.bookName %>
        </h1>

        <!-- Product Information Layout -->
        <div class="product-info-column">

          <!-- Left Column: Price and Quantity -->
          <div class="left-column">

            <!-- Price Display -->
            <div class="product-price">

              <!-- Hidden Book Data for JavaScript Use -->
              <div id="book-data" data-book-id="<%= book.bookID %>" data-price="<%= book.price %>"
                data-pro-price="<%= book.proPrice || book.price %>" <% if (book.inCart) { %>
                data-in-cart="true"
                data-cart-quantity="<%= book.cartInfo ? book.cartInfo.quantity : '1' %>"
                  data-cart-enchantment="<%= book.cartInfo ? book.cartInfo.enchantment : '' %>"
                    <% } %>
                      style="display: none;"></div>

              <!-- Price Display with/without Discount -->
              <% if (book.hasDiscount) { %>

                <!-- Discounted Price Display -->
                <div class="original-price">
                  <span style="text-decoration: line-through;">
                    <%= book.price %>
                  </span>
                  <span class="discount-badge">
                    <%= book.discountPercentage %>%
                  </span>
                </div>
                <div class="sale-price">
                  <span>
                    <%= book.proPrice %> Galleon
                  </span>
                </div>
                <% } else { %>

                  <!-- Regular Price Display -->
                  <div class="sale-price">
                    <span>
                      <%= book.price %> Galleon
                    </span>
                  </div>
                  <% } %>
            </div>

            <!-- Quantity Selector -->
            <div class="quantity-selector">
              <button class="quantity-btn decrease">-</button>
              <input type="text" class="quantity-input" value="1" readonly />
              <button class="quantity-btn increase">+</button>
            </div>
          </div>

          <!-- Right Column: Enchantment Features -->
          <div class="right-column">
            <div class="product-features">

              <!-- Enchantment Options -->
              <div class="feature">
                <input type="checkbox" />
                <label for="">Fire Resistant</label>
              </div>

              <div class="feature">
                <input type="checkbox" />
                <label for="">Self Repairing</label>
              </div>

              <div class="feature">
                <input type="checkbox" />
                <label for="">Magical Lock </label>
              </div>
            </div>
          </div>
        </div>

        <!-- Add to Cart Button -->
        <button class="add-to-cart-btn" type="button">
          <% if (book.inCart) { %>
            Already in cart
            <% } else { %>
              Add to cart
              <% } %>
        </button>
      </div>
    </div>

    <div class="divider"></div>

    <!-- Product Description -->
    <div class="product-description-container">
      <h2>Description</h2>
      <p>
        &nbsp; &nbsp; <%= book.bookDescription || 'No description available for this book.' %>
      </p>
    </div>
  </div>
</body>

</html>